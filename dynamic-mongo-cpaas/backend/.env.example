PORT=5000
CLIENT_URL=http://localhost:5173
SYSTEM_DB_URI=mongodb://localhost:27017/multi_db

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-64-byte-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-byte-hex-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Set COOKIE_SECURE=true and COOKIE_SAME_SITE=none once frontend/backend are served over HTTPS in production.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
